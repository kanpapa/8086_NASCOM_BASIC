   719                                  BAKSTK:
   720 0000058D BB0400                  	MOV	BX,4			; Look for "FOR" block with
   721 00000590 01E3                    	ADD	BX,SP			; same index as specified
   722                                  LOKFOR:
   723 00000592 8A07                    	MOV	AL,[BX]			; Get block ID
   724                                  ;	LAHF
   725 00000594 43                      	INC	BX			; Point to index address
   726                                  ;	SAHF
   727 00000595 3C81                    	CMP	AL,ZFOR			; Is it a "FOR" token
   728 00000597 7401                    	JZ	LOKFOR1
   729 00000599 C3                      	RET				; No - exit
   730                                  LOKFOR1:
   731 0000059A 8A0F                    	MOV	CL,[BX]			; BC = Address of "FOR" index
   732                                  ;	LAHF
   733 0000059C 43                      	INC	BX
   734                                  ;	SAHF
   735 0000059D 8A2F                    	MOV	CH,[BX]
   736                                  ;	LAHF
   737 0000059F 43                      	INC	BX			; Point to sign of STEP
   738                                  ;	SAHF
   739 000005A0 53                      	PUSH	BX			; Save pointer to sign
   740 000005A1 89CB                    	MOV	BX,CX			; HL = address of "FOR" index
   741 000005A3 88F0                    	MOV	AL,DH			; See if an index was specified
   742 000005A5 08D0                    	OR	AL,DL			; DE = 0 if no index specified
   743 000005A7 87DA                    	XCHG	BX,DX			; Specified index into HL
   744 000005A9 7405                    	JZ	INDFND			; Skip if no index given
   745 000005AB 87DA                    	XCHG	BX,DX			; Index back into DE
   746 000005AD E8FB03                  	CALL	CPDEHL			; Compare index with one given
   747                                  INDFND:

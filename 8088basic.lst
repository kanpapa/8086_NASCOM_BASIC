    19                                  
    20                                  ;RAM	EQU	0000h	; RAM top
    21                                  ;ROM	EQU	8000h	; Rom top
    22                                  ;SYSSTK	EQU	0500h	; Stack top
    23                                  ;EMEM	EQU	0000h	; Memory top in emulation mode

   121                                  ;
   122                                  ;	Start
   123                                  start:
   124 00000022 FA                          cli
   125                                  ; --- セグメントレジスタの統一 (RAM実行用) ---
   126 00000023 8CC8                        mov     ax, cs          ; 現在のCS（おそらく0000h）を取得
   127 00000025 8ED8                        mov     ds, ax          ; DS = CS にする（これでデータアクセスが正しくなる）
   128 00000027 8EC0                        mov     es, ax          ; ES も同じに
   129 00000029 8ED0                        mov     ss, ax          ; SS も同じに
   130 0000002B BCF0FF                      mov     sp, SYSSTK      ; スタックポインタ設定
   131                                      
   132                                      ; 出力抑制フラグ（DS:CTLOFG）を確実に 0 に叩く
   133 0000002E C6068F4000                  mov     byte [CTLOFG], 0 ;
   134 00000033 FB                          sti
   135 00000034 E9C901                      jmp     PROG_CODE        ;
   136                                  
   137                                  ;;
   138                                  ;;	Returned native mode
   139                                  ;	mov	si,offset natv	;8088 message
   140                                  ;	call	puts		;Out it
   141                                  ;	jmps	$		;Stop
   142                                  ;;
   143                                  
   144                                  
   145                                  ;       MS-BASIC START UP ROUTINE
   146                                  ;       TARGET: SBC8080
   147                                  ;       ASSEMBLER: ARCPIT XZ80.EXE
   148                                  ;
   149                                  ;	ORG	EMROM
   150                                  
   151                                  ; EMROM (0x8200) から ROM開始位置 (0x8000) を引いた「オフセット値(0x200)」を目標にします。
   152                                  ; ($ - $$) は「ファイルの先頭からの現在のバイト数」を表す純粋な数値になります。
   153                                  
   154 00000037 00<rep 1C9h>            times 0x200 - ($ - $$) db 0x00;
   155                                  
   156                                  ;       START BASIC
   157                                  PROG_CODE:
   158 00000200 EB05                    	JMP	COLD
   159                                  
   160                                  CHKCHR:
   161                                  	;MOV	AL,[RBFCNT]
   162 00000202 B000                    	MOV	AL,0
   163 00000204 3C00                    	CMP	AL,00H
   164 00000206 C3                      	RET

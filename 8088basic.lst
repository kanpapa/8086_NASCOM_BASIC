     1                                  ;	8088 NASCOM BASIC
     2                                  ;		Converted source code from 8080/Z80 to 8086
     3                                  ;	Assembler: Macro Assembler 1.42
     4                                  ;
     5                                  ;
     6                                  ;	SBCV20 NASCOM BASIC
     7                                  ;	Assembler: asm86.com/asm86.cmd
     8                                  ;
     9                                  
    10                                  ;	CPU	8086
    11                                  ;	ASSUME	CS:CODE, DS:DATA, SS:DATA, ES:NOTHING
    12                                  
    13                                  cpu 8086
    14                                  bits 16
    15                                  
    16                                  ;RAM	EQU	0000h	; RAM top
    17                                  ;ROM	EQU	8000h	; Rom top
    18                                  ;SYSSTK	EQU	0500h	; Stack top
    19                                  ;EMEM	EQU	0000h	; Memory top in emulation mode
    20                                  ;EMROM	EQU	8200h	; Start address in emulation mode
    21                                  
    22                                  ;RAMTOP	EQU	0800h 	; BASIC Work space
    23                                  
    24                                  ;REGAD	EQU	00h	; 8251 data register
    25                                  ;REGAC	EQU	01h	; 8251 control register
    26                                  ;RTSHIG	EQU	17h	; RTS high
    27                                  ;RTSLOW	EQU	37h	; RTS low
    28                                  ;
    29                                  BUFSIZ	EQU	128		; Buffer size(2^n, max128)
    30                                  FULSIZ	EQU	BUFSIZ*14/16	; Buffer almost full
    31                                  ;
    32                                  REGAD   equ     0xd8        ; uPD71051 data
    33                                  REGAC   equ     0xda        ; uPD71051 control
    34                                  ; データとスタックは セグメント 0x0000 に配置
    35                                  RAMTOP  equ     0x4000      ; 変数・ワークエリアの開始位置
    36                                  SYSSTK  equ     0xFFF0      ; スタックはメモリの一番上（偶数アドレス推奨）
    37                                  ;
    38                                  ;	dseg
    39                                  ;	SEGMENT	DATA
    40                                  ;	ORG	RAM
    41                                  ;
    42                                  ;	Interrupt vector
    43                                  ;DEVERR	DS	4	; Devide error
    44                                  ;BRK_FLG	DS	4	; Break flag
    45                                  ;NMIREQ	DS	4	; Non maskable interrupt
    46                                  ;BR3INS	DS	4	; BRK3 instruction
    47                                  ;BRVINS	DS	4	; BRKV instruction
    48                                  ;CHKINS	DS	4	; CHKIND instruction
    49                                  
    50                                  ;	ORG	0400h-20
    51                                  ;VGETCH	DS	4	; CALLN 251
    52                                  ;VKBHIT	DS	4	; CALLN 252
    53                                  ;VPUTCH	DS	4	; CALLN 253
    54                                  ;VBRKEM	DS	4	; BRKEM 254
    55                                  ;INTREQ	DS	4	; External interrupt
    56                                  ;
    57                                  ;	Receive buffer
    58                                  ;RECBUF	DS	BUFSIZ	; Buffer
    59                                  ;RBFRDP	DS	2	; Read address
    60                                  ;RBFWTP	DS	2	; Write address
    61                                  ;RBFCNT	DS	1	; Count of chars
    62                                  ;
    63                                  
    64                                  
    65                                  
    66                                  section .text
    67                                  org 0x0000                  ; モニターで g 8000 0000 する場合
    68                                  ;	cseg
    69                                  ;	SEGMENT	CODE
    70                                  ;	ORG	ROM
    71                                  
    72 00000000 EB20                    	jmp	start
    73                                  
    74                                  getch:
    75 00000002 E4DA                        in      al, REGAC       ;
    76 00000004 A802                        test    al, 02h         ; RxRDY ビット確認
    77 00000006 74FA                        jz      getch           ;
    78 00000008 E4D8                        in      al, REGAD       ;
    79 0000000A C3                          ret
    80                                  
    81                                  putch:
    82 0000000B 50                          push    ax              ;
    83                                  pcst1:
    84 0000000C E4DA                        in      al, REGAC       ;
    85 0000000E A801                        test    al, 01h         ; TxRDY ビット確認
    86 00000010 74FA                        jz      pcst1           ;
    87 00000012 58                          pop     ax              ;
    88 00000013 E6D8                        out     REGAD, al       ;
    89 00000015 C3                          ret
    90                                  
    91                                  puts:
    92 00000016 FC                          cld                     ;
    93                                  ptst1:
    94 00000017 AC                          lodsb                ; 【重要】NASM構文。文字列はコード領域(CS)にあるため
    95 00000018 3C00                        cmp     al, 0           ;
    96 0000001A 7405                        jz      ptext           ;
    97 0000001C E8ECFF                      call    putch           ;
    98 0000001F EBF6                        jmp     ptst1           ;
    99                                  ptext:
   100 00000021 C3                          ret
   101                                  ;;
   102                                  ;;	message
   103                                  ;ckcpu	db	13,10,'PROCESSOR: ',0
   104                                  ;nec	db	'NEC V20(uPD70108)',13,10
   105                                  ;	db	'It will soon be turned 8080 emulation mode.',13,10,0
   106                                  ;intel	db	'Intel 8088',13,10
   107                                  ;	db	'Sorry, It will soon be out of control',13,10,0

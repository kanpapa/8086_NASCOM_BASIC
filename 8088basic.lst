    78                                  getch:
    79 00000002 E4DA                        in      al, REGAC       ;
    80 00000004 A802                        test    al, 02h         ; RxRDY ビット確認
    81 00000006 74FA                        jz      getch           ;
    82 00000008 E4D8                        in      al, REGAD       ;
    83 0000000A C3                          ret
    84                                  
    85                                  putch:
    86 0000000B 50                          push    ax              ;
    87                                  pcst1:
    88 0000000C E4DA                        in      al, REGAC       ;
    89 0000000E A801                        test    al, 01h         ; TxRDY ビット確認
    90 00000010 74FA                        jz      pcst1           ;
    91 00000012 58                          pop     ax              ;
    92 00000013 E6D8                        out     REGAD, al       ;
    93 00000015 C3                          ret
    94                                  
    95                                  puts:
    96 00000016 FC                          cld                     ;
    97                                  ptst1:
    98 00000017 AC                          lodsb                ; 【重要】NASM構文。文字列はコード領域(CS)にあるため
    99 00000018 3C00                        cmp     al, 0           ;
   100 0000001A 7405                        jz      ptext           ;
   101 0000001C E8ECFF                      call    putch           ;
   102 0000001F EBF6                        jmp     ptst1           ;
   103                                  ptext:
   104 00000021 C3                          ret

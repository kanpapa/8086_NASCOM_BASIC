   192                                  ; GENERAL EQUATES
   193                                  ;
   194                                  CTRLC		EQU	03H	; Control "C"
   195                                  CTRLG		EQU	07H	; Control "G"
   196                                  BKSP		EQU	08H	; Back space
   197                                  LF		EQU	0AH	; Line feed
   198                                  CLRSCRN		EQU	0CH	; Clear screen
   199                                  CR		EQU	0DH	; Carriage return
   200                                  CTRLO		EQU	0FH	; Control "O"
   201                                  CTRLQ		EQU	11H	; Control "Q"
   202                                  CTRLR		EQU	12H	; Control "R"
   203                                  CTRLS		EQU	13H	; Control "S"
   204                                  CTRLU		EQU	15H	; Control "U"
   205                                  ESC		EQU	1BH	; Escape
   206                                  DEL		EQU	7FH	; Delete
   207                                  ;
   208                                  ; BASIC WORK SPACE LOCATIONS
   209                                  ;
   210                                  WRKSPC		EQU	RAMTOP+45H  ; BASIC Work space
   211                                  USR		EQU	WRKSPC+3H   ; "USR (x)" jump
   212                                  OUTSUB		EQU	WRKSPC+6H   ; "OUT p,n"
   213                                  OTPORT		EQU	WRKSPC+7H   ; Port (p)
   214                                  DIVSUP		EQU	WRKSPC+9H   ; Division support routine
   215                                  DIV1		EQU	WRKSPC+0AH  ; <- Values
   216                                  ;DIV2		EQU	WRKSPC+0EH  ; <- to
   217                                  ;DIV3		EQU	WRKSPC+12H  ; <- be
   218                                  ;DIV4		EQU	WRKSPC+15H  ; <- inserted
   219                                  DIV2		EQU	WRKSPC+10H  ; <- to
   220                                  DIV3		EQU	WRKSPC+16H  ; <- be
   221                                  DIV4		EQU	WRKSPC+1AH  ; <- inserted
   222                                  SEED		EQU	WRKSPC+1CH  +5; Random number seed
   223                                  LSTRND		EQU	WRKSPC+3AH  +5; Last random number
   224                                  INPSUB		EQU	WRKSPC+3EH  +5; #INP (x)" Routine
   225                                  INPORT		EQU	WRKSPC+3FH  +5; PORT (x)
   226                                  NULLS		EQU	WRKSPC+41H  +5; Number of nulls
   227                                  LWIDTH		EQU	WRKSPC+42H  +5; Terminal width
   228                                  COMMAN		EQU	WRKSPC+43H  +5; Width for commas
   229                                  NULFLG		EQU	WRKSPC+44H  +5; Null after input byte flag
   230                                  CTLOFG		EQU	WRKSPC+45H  +5; Control "O" flag
   231                                  LINESC		EQU	WRKSPC+46H  +5; Lines counter
   232                                  LINESN		EQU	WRKSPC+48H  +5; Lines number
   233                                  CHKSUM		EQU	WRKSPC+4AH  +5; rray load/save check sum
   234                                  NMIFLG		EQU	WRKSPC+4CH  +5; Flag for NMI break routine
   235                                  BRKFLG		EQU	WRKSPC+4DH  +5; Break flag
   236                                  RINPUT		EQU	WRKSPC+4EH  +5; Input reflection
   237                                  POINT		EQU	WRKSPC+51H  +5; "POINT" reflection (unused)
   238                                  PSET		EQU	WRKSPC+54H  +5; "SET"   reflection
   239                                  RESET		EQU	WRKSPC+57H  +5; "RESET" reflection
   240                                  STRSPC		EQU	WRKSPC+5AH  +5; Bottom of string space
   241                                  LINEAT		EQU	WRKSPC+5CH  +5; Current line number
   242                                  BASTXT		EQU	WRKSPC+5EH  +5; Pointer to start of program
   243                                  BUFFER		EQU	WRKSPC+61H  +5; Input buffer
   244                                  STACK		EQU	WRKSPC+66H  +5; Initial stack
   245                                  CURPOS		EQU	WRKSPC+0ABH +5; Character position on line
   246                                  LCRFLG		EQU	WRKSPC+0ACH +5; Locate/Create flag
   247                                  TYPE		EQU	WRKSPC+0ADH +5; Data type flag
   248                                  DATFLG		EQU	WRKSPC+0AEH +5; Literal statement flag
   249                                  LSTRAM		EQU	WRKSPC+0AFH +5; Last available RAM
   250                                  TMSTPT		EQU	WRKSPC+0B1H +5; Temporary string pointer
   251                                  TMSTPL		EQU	WRKSPC+0B3H +5; Temporary string pool
   252                                  TMPSTR		EQU	WRKSPC+0BFH +5; Temporary string
   253                                  STRBOT		EQU	WRKSPC+0C3H +5; Bottom of string space
   254                                  CUROPR		EQU	WRKSPC+0C5H +5; Current operator in EVAL
   255                                  LOOPST		EQU	WRKSPC+0C7H +5; First statement of loop
   256                                  DATLIN		EQU	WRKSPC+0C9H +5; Line of current DATA item
   257                                  FORFLG		EQU	WRKSPC+0CBH +5; "FOR" loop flag
   258                                  LSTBIN		EQU	WRKSPC+0CCH +5; Last byte entered
   259                                  READFG		EQU	WRKSPC+0CDH +5; Read/Input flag
   260                                  BRKLIN		EQU	WRKSPC+0CEH +5; Line of break
   261                                  NXTOPR		EQU	WRKSPC+0D0H +5; Next operator in EVAL
   262                                  ERRLIN		EQU	WRKSPC+0D2H +5; Line of error
   263                                  CONTAD		EQU	WRKSPC+0D4H +5; Where to CONTinue
   264                                  PROGND		EQU	WRKSPC+0D6H +5; End of program
   265                                  VAREND		EQU	WRKSPC+0D8H +5; End of variables
   266                                  ARREND		EQU	WRKSPC+0DAH +5; End of arrays
   267                                  NXTDAT		EQU	WRKSPC+0DCH +5; Next data item
   268                                  FNRGNM		EQU	WRKSPC+0DEH +5; Name of FN argument
   269                                  FNARG		EQU	WRKSPC+0E0H +5; FN argument value
   270                                  FPREG		EQU	WRKSPC+0E4H +5; Floating point register
   271                                  FPEXP		EQU	FPREG+3       ; Floating point exponent
   272                                  SGNRES		EQU	WRKSPC+0E8H +5; Sign of result
   273                                  PBUFF		EQU	WRKSPC+0E9H +5; Number print buffer
   274                                  MULVAL		EQU	WRKSPC+0F6H +5; Multiplier
   275                                  PROGST		EQU	WRKSPC+0F9H +5; Start of program text area
   276                                  STLOOK		EQU	WRKSPC+15DH +5; Start of memory test
   277                                  ;
   278                                  ; BASIC ERROR CODE VALUES
   279                                  ;
   280                                  NF	EQU	00H	; NEXT without FOR
   281                                  SN	EQU	02H	; Syntax error
   282                                  RG	EQU	04H	; RETURN without GOSUB
   283                                  OD	EQU	06H	; Out of DATA
   284                                  FC	EQU	08H	; Function call error
   285                                  OV	EQU	0AH	; Overflow
   286                                  OM	EQU	0CH	; Out of memory
   287                                  UL	EQU	0EH	; Undefined line number
   288                                  BS	EQU	10H	; Bad subscript
   289                                  RD	EQU	12H	; Re-DIMensioned array
   290                                  _DZ	EQU	14H	; Division by zero (/0)
   291                                  ID	EQU	16H	; Illegal direct
   292                                  TM	EQU	18H	; Type miss-match
   293                                  OS	EQU	1AH	; Out of string space
   294                                  LS	EQU	1CH	; String too long
   295                                  ST	EQU	1EH	; String formula too complex
   296                                  CN	EQU	20H	; Can't CONTinue
   297                                  UF	EQU	22H	; UnDEFined FN function
   298                                  MO	EQU	24H	; Missing operand
   299                                  HX	EQU	26H	; HEX error
   300                                  BN	EQU	28H	; BIN error
   301                                  ;
   302                                  COLD:
   303 00000207 EB03                    	JMP	STARTB			; Jump for cold start jump
   304                                  WARM:
   305 00000209 E98B00                  	JMP	WARMST			; Jump for warm start jump
   306                                  STARTB:
   307 0000020C EB04                    	JMP	CSTART			; Jump to initialise
   308                                  ;
   309 0000020E [C50C]                  	DW	DEINT			; Get integer -32768 to 32767
   310 00000210 [1617]                  	DW	ABPASS			; Return integer in AB
   311                                  ;
   312                                  CSTART:
   313                                  	;MOV	BX,WRKSPC		; Start of workspace RAM
   314                                  	;MOV	SP,BX			; Set up a temporary stack
   315 00000212 E95725                  	JMP	INITST			; Go to initialise
   316                                  ;
   317                                  INIT:
   318 00000215 BA[1005]                	MOV	DX,INITAB		; Initialise workspace
   319 00000218 B568                    	MOV	CH,INITBE-INITAB+3	; Bytes to copy
   320 0000021A BB4540                  	MOV	BX,WRKSPC		; Into workspace RAM
   321                                  COPY:
   322 0000021D 87DA                    	XCHG	BX,DX
   323 0000021F 8A07                    	MOV	AL,[BX]			; Get source
   324 00000221 87DA                    	XCHG	BX,DX
   325 00000223 8807                    	MOV	[BX],AL			; To destination
   326                                  ;	LAHF
   327 00000225 43                      	INC	BX			; Next destination
   328                                  ;	SAHF
   329                                  ;	LAHF
   330 00000226 42                      	INC	DX			; Next source
   331                                  ;	SAHF
   332 00000227 FECD                    	DEC	CH			; Count bytes
   333 00000229 75F2                    	JNZ	COPY			; More to move
   334                                  	;MOV	SP,BX			; Temporary stack
   335 0000022B E88E05                  	CALL	CLREG			; Clear registers and stack
   336 0000022E E8250D                  	CALL	PRCRLF			; Output CRLF
   337 00000231 A2F440                  	MOV	[BUFFER+72+1],AL	; Mark end of buffe
   338 00000234 A24341                  	MOV	[PROGST],AL  		; Initialise program area
   339                                  MSIZE:
   340                                  	;MOV	BX,STLOOK		; Point to start of RAM
   341 00000237 BB0080                  	mov	bx, 0x8000
   342 0000023A EB17                    	jmp	SETTOP
   343                                  
   344                                  MLOOP:
   345 0000023C 9F                      	LAHF
   346 0000023D 43                      	INC	BX			; Next byte
   347 0000023E 9E                      	SAHF
   348 0000023F 88F8                    	MOV	AL,BH			; Above address FFFF ?
   349 00000241 08D8                    	OR	AL,BL
   350 00000243 740E                    	JZ	SETTOP			; Yes - 64K RAM
   351 00000245 8A07                    	MOV	AL,[BX]			; Get contents
   352 00000247 88C5                    	MOV	CH,AL			; Save it
   353 00000249 F6D0                    	NOT	AL			; Flip all bits
   354 0000024B 8807                    	MOV	[BX],AL			; Put it back
   355 0000024D 3A07                    	CMP	AL,[BX]			; RAM there if same
   356 0000024F 882F                    	MOV	[BX],CH			; Restore old contents
   357 00000251 74E9                    	JZ	MLOOP			; If RAM - test next byte
   358                                  ;
   359                                  SETTOP:
   360 00000253 9F                      	LAHF
   361 00000254 4B                      	DEC	BX			; Back one byte
   362 00000255 9E                      	SAHF
   363 00000256 BAA641                  	MOV	DX,STLOOK-1		; See if enough RAM
   364 00000259 E84F07                  	CALL	CPDEHL			; Compare DE with HL
   365 0000025C 7242                    	JC	NEMEM			; If not enough RAM
   366 0000025E BACEFF                  	MOV	DX,0-50			; 50 Bytes string space
   367 00000261 891EF940                	MOV	[LSTRAM],BX		; Save last available RAM
   368 00000265 01D3                    	ADD	BX,DX			; Allocate string space
   369 00000267 891EA440                	MOV	[STRSPC],BX		; Save string space
   370 0000026B E81605                  	CALL	CLRPTR			; Clear program area
   371 0000026E 8B1EA440                	MOV	BX,[STRSPC]		; Get end of memory
   372 00000272 BAEFFF                  	MOV	DX,0-17			; Offset for free bytes
   373 00000275 01D3                    	ADD	BX,DX			; Adjust HL
   374 00000277 BA4341                  	MOV	DX,PROGST		; Start of program text
   375 0000027A 88D8                    	MOV	AL,BL			; Get LSB
   376 0000027C 28D0                    	SUB	AL,DL			; Adjust it
   377 0000027E 88C3                    	MOV	BL,AL			; Re-save
   378 00000280 88F8                    	MOV	AL,BH			; Get MSB
   379 00000282 18F0                    	SBB	AL,DH			; Adjust it
   380 00000284 88C7                    	MOV	BH,AL			; Re-save
   381 00000286 53                      	PUSH	BX			; Save bytes free
   382 00000287 BB[B702]                	MOV	BX,SIGNON		; Sign-on message
   383 0000028A E80E16                  	CALL	PRS			; Output string
   384 0000028D 5B                      	POP	BX			; Get bytes free back
   385 0000028E E8821F                  	CALL	PRNTHL			; Output amount of free memory
   386 00000291 BB[A802]                	MOV	BX,BFREE		; " Bytes free" message
   387 00000294 E80416                  	CALL	PRS			; Output string
   388                                  WARMST:
   389                                  	;MOV	SP,STACK		; Temporary stack
   390 00000297 BCF0FF                  	MOV	SP,SYSSTK		; Temporary stack
   391                                  BRKRET:

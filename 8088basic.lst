   750 000005B4 7501                    	JNZ	INDFND1
   751 000005B6 C3                      	RET				; Return if block found
   752                                  INDFND1:
   753 000005B7 01CB                    	ADD	BX,CX			; Point to next block
   754 000005B9 EBD7                    	JMP	LOKFOR			; Keep on looking

   182                                  ; NASCOM ROM BASIC Ver 4.7, (C) 1978 Microsoft
   183                                  ; Scanned from source published in 80-BUS NEWS from Vol 2, Issue 3
   184                                  ; (May-June 1983) to Vol 3, Issue 3 (May-June 1984)
   185                                  ; Adapted for the freeware Zilog Macro Assembler 2.10 to produce
   186                                  ; the original ROM code (checksum A934H). PA
   187                                  ;
   188                                  ; GENERAL EQUATES
   189                                  ;
   190                                  CTRLC		EQU	03H	; Control "C"
   191                                  CTRLG		EQU	07H	; Control "G"
   192                                  BKSP		EQU	08H	; Back space
   193                                  LF		EQU	0AH	; Line feed
   194                                  CLRSCRN		EQU	0CH	; Clear screen
   195                                  CR		EQU	0DH	; Carriage return
   196                                  CTRLO		EQU	0FH	; Control "O"
   197                                  CTRLQ		EQU	11H	; Control "Q"
   198                                  CTRLR		EQU	12H	; Control "R"
   199                                  CTRLS		EQU	13H	; Control "S"
   200                                  CTRLU		EQU	15H	; Control "U"
   201                                  ESC		EQU	1BH	; Escape
   202                                  DEL		EQU	7FH	; Delete
   203                                  ;
   204                                  ; BASIC WORK SPACE LOCATIONS
   205                                  ;
   206                                  WRKSPC		EQU	RAMTOP+45H  ; BASIC Work space
   207                                  USR		EQU	WRKSPC+3H   ; "USR (x)" jump
   208                                  OUTSUB		EQU	WRKSPC+6H   ; "OUT p,n"
   209                                  OTPORT		EQU	WRKSPC+7H   ; Port (p)
   210                                  DIVSUP		EQU	WRKSPC+9H   ; Division support routine
   211                                  DIV1		EQU	WRKSPC+0AH  ; <- Values
   212                                  ;DIV2		EQU	WRKSPC+0EH  ; <- to
   213                                  ;DIV3		EQU	WRKSPC+12H  ; <- be
   214                                  ;DIV4		EQU	WRKSPC+15H  ; <- inserted
   215                                  DIV2		EQU	WRKSPC+10H  ; <- to
   216                                  DIV3		EQU	WRKSPC+16H  ; <- be
   217                                  DIV4		EQU	WRKSPC+1AH  ; <- inserted
   218                                  SEED		EQU	WRKSPC+1CH  +5; Random number seed
   219                                  LSTRND		EQU	WRKSPC+3AH  +5; Last random number
   220                                  INPSUB		EQU	WRKSPC+3EH  +5; #INP (x)" Routine
   221                                  INPORT		EQU	WRKSPC+3FH  +5; PORT (x)
   222                                  NULLS		EQU	WRKSPC+41H  +5; Number of nulls
   223                                  LWIDTH		EQU	WRKSPC+42H  +5; Terminal width
   224                                  COMMAN		EQU	WRKSPC+43H  +5; Width for commas
   225                                  NULFLG		EQU	WRKSPC+44H  +5; Null after input byte flag
   226                                  CTLOFG		EQU	WRKSPC+45H  +5; Control "O" flag
   227                                  LINESC		EQU	WRKSPC+46H  +5; Lines counter
   228                                  LINESN		EQU	WRKSPC+48H  +5; Lines number
   229                                  CHKSUM		EQU	WRKSPC+4AH  +5; rray load/save check sum
   230                                  NMIFLG		EQU	WRKSPC+4CH  +5; Flag for NMI break routine
   231                                  BRKFLG		EQU	WRKSPC+4DH  +5; Break flag
   232                                  RINPUT		EQU	WRKSPC+4EH  +5; Input reflection
   233                                  POINT		EQU	WRKSPC+51H  +5; "POINT" reflection (unused)
   234                                  PSET		EQU	WRKSPC+54H  +5; "SET"   reflection
   235                                  RESET		EQU	WRKSPC+57H  +5; "RESET" reflection
   236                                  STRSPC		EQU	WRKSPC+5AH  +5; Bottom of string space
   237                                  LINEAT		EQU	WRKSPC+5CH  +5; Current line number
   238                                  BASTXT		EQU	WRKSPC+5EH  +5; Pointer to start of program
   239                                  BUFFER		EQU	WRKSPC+61H  +5; Input buffer
   240                                  STACK		EQU	WRKSPC+66H  +5; Initial stack
   241                                  CURPOS		EQU	WRKSPC+0ABH +5; Character position on line
   242                                  LCRFLG		EQU	WRKSPC+0ACH +5; Locate/Create flag
   243                                  TYPE		EQU	WRKSPC+0ADH +5; Data type flag
   244                                  DATFLG		EQU	WRKSPC+0AEH +5; Literal statement flag
   245                                  LSTRAM		EQU	WRKSPC+0AFH +5; Last available RAM
   246                                  TMSTPT		EQU	WRKSPC+0B1H +5; Temporary string pointer
   247                                  TMSTPL		EQU	WRKSPC+0B3H +5; Temporary string pool
   248                                  TMPSTR		EQU	WRKSPC+0BFH +5; Temporary string
   249                                  STRBOT		EQU	WRKSPC+0C3H +5; Bottom of string space
   250                                  CUROPR		EQU	WRKSPC+0C5H +5; Current operator in EVAL
   251                                  LOOPST		EQU	WRKSPC+0C7H +5; First statement of loop
   252                                  DATLIN		EQU	WRKSPC+0C9H +5; Line of current DATA item
   253                                  FORFLG		EQU	WRKSPC+0CBH +5; "FOR" loop flag
   254                                  LSTBIN		EQU	WRKSPC+0CCH +5; Last byte entered
   255                                  READFG		EQU	WRKSPC+0CDH +5; Read/Input flag
   256                                  BRKLIN		EQU	WRKSPC+0CEH +5; Line of break
   257                                  NXTOPR		EQU	WRKSPC+0D0H +5; Next operator in EVAL
   258                                  ERRLIN		EQU	WRKSPC+0D2H +5; Line of error
   259                                  CONTAD		EQU	WRKSPC+0D4H +5; Where to CONTinue
   260                                  PROGND		EQU	WRKSPC+0D6H +5; End of program
   261                                  VAREND		EQU	WRKSPC+0D8H +5; End of variables
   262                                  ARREND		EQU	WRKSPC+0DAH +5; End of arrays
   263                                  NXTDAT		EQU	WRKSPC+0DCH +5; Next data item
   264                                  FNRGNM		EQU	WRKSPC+0DEH +5; Name of FN argument
   265                                  FNARG		EQU	WRKSPC+0E0H +5; FN argument value
   266                                  FPREG		EQU	WRKSPC+0E4H +5; Floating point register
   267                                  FPEXP		EQU	FPREG+3       ; Floating point exponent
   268                                  SGNRES		EQU	WRKSPC+0E8H +5; Sign of result
   269                                  PBUFF		EQU	WRKSPC+0E9H +5; Number print buffer
   270                                  MULVAL		EQU	WRKSPC+0F6H +5; Multiplier
   271                                  PROGST		EQU	WRKSPC+0F9H +5; Start of program text area
   272                                  STLOOK		EQU	WRKSPC+15DH +5; Start of memory test
   273                                  ;
   274                                  ; BASIC ERROR CODE VALUES
   275                                  ;
   276                                  NF	EQU	00H	; NEXT without FOR
   277                                  SN	EQU	02H	; Syntax error
   278                                  RG	EQU	04H	; RETURN without GOSUB
   279                                  OD	EQU	06H	; Out of DATA
   280                                  FC	EQU	08H	; Function call error
   281                                  OV	EQU	0AH	; Overflow
   282                                  OM	EQU	0CH	; Out of memory
   283                                  UL	EQU	0EH	; Undefined line number
   284                                  BS	EQU	10H	; Bad subscript
   285                                  RD	EQU	12H	; Re-DIMensioned array
   286                                  _DZ	EQU	14H	; Division by zero (/0)
   287                                  ID	EQU	16H	; Illegal direct
   288                                  TM	EQU	18H	; Type miss-match
   289                                  OS	EQU	1AH	; Out of string space
   290                                  LS	EQU	1CH	; String too long
   291                                  ST	EQU	1EH	; String formula too complex
   292                                  CN	EQU	20H	; Can't CONTinue
   293                                  UF	EQU	22H	; UnDEFined FN function
   294                                  MO	EQU	24H	; Missing operand
   295                                  HX	EQU	26H	; HEX error
   296                                  BN	EQU	28H	; BIN error
   297                                  ;
   298                                  COLD:
   299 00000207 EB03                    	JMP	STARTB			; Jump for cold start jump
   300                                  WARM:
   301 00000209 E98B00                  	JMP	WARMST			; Jump for warm start jump
   302                                  STARTB:
   303 0000020C EB04                    	JMP	CSTART			; Jump to initialise
   304                                  ;
   305 0000020E [C50C]                  	DW	DEINT			; Get integer -32768 to 32767
   306 00000210 [1617]                  	DW	ABPASS			; Return integer in AB
   307                                  ;
   308                                  CSTART:
   309                                  	;MOV	BX,WRKSPC		; Start of workspace RAM
   310                                  	;MOV	SP,BX			; Set up a temporary stack
   311 00000212 E95725                  	JMP	INITST			; Go to initialise
   312                                  ;
   313                                  INIT:
   314 00000215 BA[1005]                	MOV	DX,INITAB		; Initialise workspace
   315 00000218 B568                    	MOV	CH,INITBE-INITAB+3	; Bytes to copy
   316 0000021A BB4540                  	MOV	BX,WRKSPC		; Into workspace RAM
   317                                  COPY:
   318 0000021D 87DA                    	XCHG	BX,DX
   319 0000021F 8A07                    	MOV	AL,[BX]			; Get source
   320 00000221 87DA                    	XCHG	BX,DX
   321 00000223 8807                    	MOV	[BX],AL			; To destination
   322                                  ;	LAHF
   323 00000225 43                      	INC	BX			; Next destination
   324                                  ;	SAHF
   325                                  ;	LAHF
   326 00000226 42                      	INC	DX			; Next source
   327                                  ;	SAHF
   328 00000227 FECD                    	DEC	CH			; Count bytes
   329 00000229 75F2                    	JNZ	COPY			; More to move
   330                                  	;MOV	SP,BX			; Temporary stack
   331 0000022B E88E05                  	CALL	CLREG			; Clear registers and stack
   332 0000022E E8250D                  	CALL	PRCRLF			; Output CRLF
   333 00000231 A2F440                  	MOV	[BUFFER+72+1],AL	; Mark end of buffe
   334 00000234 A24341                  	MOV	[PROGST],AL  		; Initialise program area
   335                                  MSIZE:
   336                                  	;MOV	BX,STLOOK		; Point to start of RAM
   337 00000237 BB0080                  	mov	bx, 0x8000
   338 0000023A EB17                    	jmp	SETTOP
   339                                  
   340                                  MLOOP:
   341 0000023C 9F                      	LAHF
   342 0000023D 43                      	INC	BX			; Next byte
   343 0000023E 9E                      	SAHF
   344 0000023F 88F8                    	MOV	AL,BH			; Above address FFFF ?
   345 00000241 08D8                    	OR	AL,BL
   346 00000243 740E                    	JZ	SETTOP			; Yes - 64K RAM
   347 00000245 8A07                    	MOV	AL,[BX]			; Get contents
   348 00000247 88C5                    	MOV	CH,AL			; Save it
   349 00000249 F6D0                    	NOT	AL			; Flip all bits
   350 0000024B 8807                    	MOV	[BX],AL			; Put it back
   351 0000024D 3A07                    	CMP	AL,[BX]			; RAM there if same
   352 0000024F 882F                    	MOV	[BX],CH			; Restore old contents
   353 00000251 74E9                    	JZ	MLOOP			; If RAM - test next byte
   354                                  ;
   355                                  SETTOP:
   356 00000253 9F                      	LAHF
   357 00000254 4B                      	DEC	BX			; Back one byte
   358 00000255 9E                      	SAHF
   359 00000256 BAA641                  	MOV	DX,STLOOK-1		; See if enough RAM
   360 00000259 E84F07                  	CALL	CPDEHL			; Compare DE with HL
   361 0000025C 7242                    	JC	NEMEM			; If not enough RAM
   362 0000025E BACEFF                  	MOV	DX,0-50			; 50 Bytes string space
   363 00000261 891EF940                	MOV	[LSTRAM],BX		; Save last available RAM
   364 00000265 01D3                    	ADD	BX,DX			; Allocate string space
   365 00000267 891EA440                	MOV	[STRSPC],BX		; Save string space
   366 0000026B E81605                  	CALL	CLRPTR			; Clear program area
   367 0000026E 8B1EA440                	MOV	BX,[STRSPC]		; Get end of memory
   368 00000272 BAEFFF                  	MOV	DX,0-17			; Offset for free bytes
   369 00000275 01D3                    	ADD	BX,DX			; Adjust HL
   370 00000277 BA4341                  	MOV	DX,PROGST		; Start of program text
   371 0000027A 88D8                    	MOV	AL,BL			; Get LSB
   372 0000027C 28D0                    	SUB	AL,DL			; Adjust it
   373 0000027E 88C3                    	MOV	BL,AL			; Re-save
   374 00000280 88F8                    	MOV	AL,BH			; Get MSB
   375 00000282 18F0                    	SBB	AL,DH			; Adjust it
   376 00000284 88C7                    	MOV	BH,AL			; Re-save
   377 00000286 53                      	PUSH	BX			; Save bytes free
   378 00000287 BB[B702]                	MOV	BX,SIGNON		; Sign-on message
   379 0000028A E80E16                  	CALL	PRS			; Output string
   380 0000028D 5B                      	POP	BX			; Get bytes free back
   381 0000028E E8821F                  	CALL	PRNTHL			; Output amount of free memory
   382 00000291 BB[A802]                	MOV	BX,BFREE		; " Bytes free" message
   383 00000294 E80416                  	CALL	PRS			; Output string
   384                                  WARMST:
   385                                  	;MOV	SP,STACK		; Temporary stack
   386 00000297 BCF0FF                  	MOV	SP,SYSSTK		; Temporary stack
   387                                  BRKRET:
   388 0000029A E81F05                  	CALL	CLREG			; Clear registers and s
   389 0000029D E9C203                  	JMP	PRNTOK			; Go to get command lin
   390                                  ;
   391                                  NEMEM:
   392 000002A0 BB[FE02]                	MOV	BX,MEMMSG		; Memory size not enough
   393 000002A3 E8F515                  	CALL	PRS			; Print it
   394                                  XXXXX:
   395 000002A6 EBFE                    	JMP	XXXXX			; Stop

    31                                  ;RTSLOW	EQU	37h	; RTS low
    32                                  ;
    33                                  BUFSIZ	EQU	128		; Buffer size(2^n, max128)
    34                                  FULSIZ	EQU	BUFSIZ*14/16	; Buffer almost full
    35                                  ;
    36                                  REGAD   equ     0xd8        ; uPD71051 data
    37                                  REGAC   equ     0xda        ; uPD71051 control
    38                                  ; データとスタックは セグメント 0x0000 に配置
    39                                  RAMTOP  equ     0x4000      ; 変数・ワークエリアの開始位置
    40                                  SYSSTK  equ     0xFFF0      ; スタックはメモリの一番上（偶数アドレス推奨）

   126                                  ;	Start
   127                                  start:
   128 00000022 FA                          cli
   129                                  ; --- セグメントレジスタの統一 (RAM実行用) ---
   130 00000023 8CC8                        mov     ax, cs          ; 現在のCS（おそらく0000h）を取得
   131 00000025 8ED8                        mov     ds, ax          ; DS = CS にする（これでデータアクセスが正しくなる）
   132 00000027 8EC0                        mov     es, ax          ; ES も同じに
   133 00000029 8ED0                        mov     ss, ax          ; SS も同じに
   134 0000002B BCF0FF                      mov     sp, SYSSTK      ; スタックポインタ設定
   135                                      
   136                                      ; 出力抑制フラグ（DS:CTLOFG）を確実に 0 に叩く
   137 0000002E C6068F4000                  mov     byte [CTLOFG], 0 ;
   138 00000033 FB                          sti
   139 00000034 E9C901                      jmp     PROG_CODE        ;
   140                                  
   141                                  ;;
   142                                  ;;	Returned native mode
   143                                  ;	mov	si,offset natv	;8088 message
   144                                  ;	call	puts		;Out it
   145                                  ;	jmps	$		;Stop
   146                                  ;;
   147                                  
   148                                  
   149                                  ;       MS-BASIC START UP ROUTINE
   150                                  ;       TARGET: SBC8080
   151                                  ;       ASSEMBLER: ARCPIT XZ80.EXE
   152                                  ;
   153                                  ;	ORG	EMROM
   154                                  
   155                                  ; EMROM (0x8200) から ROM開始位置 (0x8000) を引いた「オフセット値(0x200)」を目標にします。
   156                                  ; ($ - $$) は「ファイルの先頭からの現在のバイト数」を表す純粋な数値になります。
   157                                  
   158 00000037 00<rep 1C9h>            times 0x200 - ($ - $$) db 0x00;
   159                                  
   160                                  ;       START BASIC
   161                                  PROG_CODE:
   162 00000200 EB05                    	JMP	COLD
   163                                  
   164                                  CHKCHR:
   165                                  	;MOV	AL,[RBFCNT]
   166 00000202 B000                    	MOV	AL,0
   167 00000204 3C00                    	CMP	AL,00H
   168 00000206 C3                      	RET
